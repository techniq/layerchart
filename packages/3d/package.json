    "@types/d3-scale": "^4.0.9",
    "@types/three": "^0.187.0",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "d3-scale": "^4.0.2",
    "playwright": "^1.60.0",
